# サーバー設定 (すべて任意。未設定なら下記の既定値)
PORT=3000
HOST=127.0.0.1

# MusicBrainz は User-Agent に連絡先を含めることを要求しています。
# 公開運用する場合は必ず自分の連絡先(メールアドレスまたはURL)に変更してください。
MB_CONTACT=https://example.com/contact-replace-me

# 外部API呼び出しの最小間隔 (ミリ秒)
# MusicBrainz の公式制限は 1リクエスト/秒。iTunes Search は約20回/分が目安です。
MB_MIN_INTERVAL_MS=1100
ITUNES_MIN_INTERVAL_MS=1500

# 外部API 1回あたりのタイムアウト (ミリ秒)
UPSTREAM_TIMEOUT_MS=12000

# 推薦処理全体の上限時間 (ミリ秒)。超えた場合は利用者に再試行を促します。
RECOMMEND_DEADLINE_MS=90000

# リバースプロキシ配下で運用する場合のみ 1 にする (X-Forwarded-For を信頼します)
TRUST_PROXY=0

# 1つのクライアント(IP)あたりの /api への上限 (1分間)
RATE_LIMIT_PER_MIN=40

# 同時に処理する推薦ジョブ数と、待ち行列の最大数
MAX_CONCURRENT_RECOMMEND=2
MAX_QUEUED_RECOMMEND=6
